# Data source toggle
# true  -> MySQL database (requires DB_* variables below)
# false -> static JSON files, no database needed (use this for Vercel)
USE_DB=true

# Backend - Database (MySQL required when USE_DB=true)
# For local: use your local MySQL credentials
# For a hosted DB: PlanetScale, Railway, Aiven, etc.
DB_HOST=your-mysql-host
DB_USER=your-mysql-user
DB_PASS=your-mysql-password
DB_DATABASE=lscustoms

# Backend - Auth & Session
SESSION_SECRET=change-this-to-a-long-random-string

# Backend - CORS (URL du frontend en production)
CORS_ORIGIN=https://your-app.vercel.app

# Backend - Port (local uniquement, Vercel l'ignore)
WEB_PORT=9000
